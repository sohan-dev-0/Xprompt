{
  "name": "promptlock",
  "version": "1.0.0",
  "description": "Floating glassmorphism prompt-guard overlay for developers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/verify.js && node test/step1-step2-test.js && node test/step3-test.js && node test/step4-test.js && node test/step5-security-test.js && node test/step6-verification-test.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "overlay",
    "prompt",
    "developer-tools"
  ],
  "author": "PromptLock",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@google/generative-ai": "^0.24.1",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "chokidar": "^3.6.0",
    "dotenv": "^18.0.8",
    "ignore": "^5.3.2"
  },
  "build": {
    "appId": "com.promptlock.app",
    "productName": "PromptLock",
    "directories": {
      "output": "build"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
